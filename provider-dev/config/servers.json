{
  "v1": [
    {
      "url": "https://{api_host}/v1",
      "variables": {
        "api_host": {
          "description": "The OVHcloud API host. Selected by OVH_ENDPOINT (ovh-eu, ovh-ca or ovh-us; default ovh-eu).",
          "default": "api.eu.ovhcloud.com",
          "x-stackQL-envVarSelector": {
            "envVar": "OVH_ENDPOINT",
            "default": "ovh-eu",
            "values": {
              "ovh-eu": "api.eu.ovhcloud.com",
              "ovh-ca": "api.ca.ovhcloud.com",
              "ovh-us": "api.us.ovhcloud.com"
            }
          }
        }
      }
    }
  ],
  "v2": [
    {
      "url": "https://{api_host}/v2",
      "variables": {
        "api_host": {
          "description": "The OVHcloud API host. Selected by OVH_ENDPOINT (ovh-eu, ovh-ca or ovh-us; default ovh-eu).",
          "default": "api.eu.ovhcloud.com",
          "x-stackQL-envVarSelector": {
            "envVar": "OVH_ENDPOINT",
            "default": "ovh-eu",
            "values": {
              "ovh-eu": "api.eu.ovhcloud.com",
              "ovh-ca": "api.ca.ovhcloud.com",
              "ovh-us": "api.us.ovhcloud.com"
            }
          }
        }
      }
    }
  ],
  "cloud_project": [
    {
      "url": "https://{api_host}/v1/cloud/project/{service_name}",
      "variables": {
        "api_host": {
          "description": "The OVHcloud API host. Selected by OVH_ENDPOINT (ovh-eu, ovh-ca or ovh-us; default ovh-eu).",
          "default": "api.eu.ovhcloud.com",
          "x-stackQL-envVarSelector": {
            "envVar": "OVH_ENDPOINT",
            "default": "ovh-eu",
            "values": {
              "ovh-eu": "api.eu.ovhcloud.com",
              "ovh-ca": "api.ca.ovhcloud.com",
              "ovh-us": "api.us.ovhcloud.com"
            }
          }
        },
        "service_name": {
          "description": "The Public Cloud project ID. Resolved from OVH_CLOUD_PROJECT_SERVICE when set.",
          "x-stackQL-envVar": "OVH_CLOUD_PROJECT_SERVICE"
        }
      }
    }
  ],
  "public_cloud_project": [
    {
      "url": "https://{api_host}/v2/publicCloud/project/{project_id}",
      "variables": {
        "api_host": {
          "description": "The OVHcloud API host. Selected by OVH_ENDPOINT (ovh-eu, ovh-ca or ovh-us; default ovh-eu).",
          "default": "api.eu.ovhcloud.com",
          "x-stackQL-envVarSelector": {
            "envVar": "OVH_ENDPOINT",
            "default": "ovh-eu",
            "values": {
              "ovh-eu": "api.eu.ovhcloud.com",
              "ovh-ca": "api.ca.ovhcloud.com",
              "ovh-us": "api.us.ovhcloud.com"
            }
          }
        },
        "project_id": {
          "description": "The Public Cloud project ID. Resolved from OVH_CLOUD_PROJECT_SERVICE when set.",
          "x-stackQL-envVar": "OVH_CLOUD_PROJECT_SERVICE"
        }
      }
    }
  ]
}
