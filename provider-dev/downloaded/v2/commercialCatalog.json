{
  "openapi": "3.0.0",
  "info": {
    "title": "OVHcloud API specification",
    "description": "Specification for OVHcloud API",
    "version": "1.0",
    "contact": {
      "name": "OVH",
      "email": "api@ml.ovh.net"
    }
  },
  "servers": [
    {
      "url": "https://api.eu.ovhcloud.com/v2"
    }
  ],
  "components": {
    "schemas": {
      "any": {
        "description": "Can be anything (text, int, bool, json, html, etc.)",
        "example": "This is a content of any type !"
      },
      "commercialCatalog.Blob": {
        "type": "object",
        "description": "Describes additional information of an offer, kept for transition from legacy model",
        "properties": {
          "content": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.BlobContent"
              }
            ],
            "description": "Blob content",
            "readOnly": true
          }
        }
      },
      "commercialCatalog.BlobContent": {
        "type": "object",
        "description": "Describes blob content",
        "properties": {
          "technical": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnical"
              }
            ],
            "description": "Technical information",
            "readOnly": true
          }
        }
      },
      "commercialCatalog.BlobContentTechnical": {
        "type": "object",
        "description": "Hardware and capacity characteristics of a commercial offer. Every field is optional: only the ones that make sense for the kind of product being described are set.",
        "properties": {
          "bandwidth": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnicalNetwork"
              }
            ],
            "description": "Public network bandwidth included with the offer",
            "nullable": true,
            "readOnly": true
          },
          "connection": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnicalConnection"
              }
            ],
            "description": "Characteristics of the network link the product is delivered on",
            "nullable": true,
            "readOnly": true
          },
          "connectionPerSeconds": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnicalPerSeconds"
              }
            ],
            "description": "How many new connections per second the product is rated for",
            "nullable": true,
            "readOnly": true
          },
          "cpu": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnicalCPU"
              }
            ],
            "description": "Processor the product runs on: model, core count and frequency",
            "nullable": true,
            "readOnly": true
          },
          "ephemeralLocalStorage": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnicalEphemeralStorage"
              }
            ],
            "description": "Storage attached directly to the host, which does not survive the product being stopped or moved",
            "nullable": true,
            "readOnly": true
          },
          "gpu": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnicalGPU"
              }
            ],
            "description": "Graphics or compute accelerator included with the offer",
            "nullable": true,
            "readOnly": true
          },
          "memory": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnicalMemory"
              }
            ],
            "description": "Amount and type of RAM included with the offer",
            "nullable": true,
            "readOnly": true
          },
          "name": {
            "type": "string",
            "description": "Commercial name of the hardware configuration this describes",
            "nullable": true,
            "readOnly": true
          },
          "nodes": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnicalNodes"
              }
            ],
            "description": "How many nodes the offer is made of, for products delivered as a cluster",
            "nullable": true,
            "readOnly": true
          },
          "nvme": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnicalNvme"
              }
            ],
            "description": "NVMe storage included with the offer, when it is listed separately from the main disks",
            "nullable": true,
            "readOnly": true
          },
          "os": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnicalOS"
              }
            ],
            "description": "Operating system the product ships with",
            "nullable": true,
            "readOnly": true
          },
          "requestPerSeconds": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnicalPerSeconds"
              }
            ],
            "description": "How many requests per second the product is rated for",
            "nullable": true,
            "readOnly": true
          },
          "storage": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnicalStorage"
              }
            ],
            "description": "Disks included with the offer, and how they are arranged",
            "nullable": true,
            "readOnly": true
          },
          "throughput": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnicalThroughput"
              }
            ],
            "description": "Data throughput the product is rated for",
            "nullable": true,
            "readOnly": true
          },
          "volume": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnicalVolume"
              }
            ],
            "description": "Block storage volume included with the offer",
            "nullable": true,
            "readOnly": true
          },
          "vrack": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnicalNetwork"
              }
            ],
            "description": "Private network (vRack) bandwidth included with the offer",
            "nullable": true,
            "readOnly": true
          }
        }
      },
      "commercialCatalog.BlobContentTechnicalCPU": {
        "type": "object",
        "description": "Describes a CPU technical details",
        "properties": {
          "brand": {
            "type": "string",
            "description": "CPU Brand",
            "nullable": true,
            "readOnly": true
          },
          "cores": {
            "type": "integer",
            "description": "Number of cores",
            "readOnly": true
          },
          "frequency": {
            "type": "number",
            "description": "Frequency of CPU in GHz",
            "nullable": true,
            "readOnly": true
          },
          "maxFrequency": {
            "type": "number",
            "description": "Maximum frequency of CPU in GHz",
            "nullable": true,
            "readOnly": true
          },
          "model": {
            "type": "string",
            "description": "Displayable name",
            "nullable": true,
            "readOnly": true
          },
          "threads": {
            "type": "integer",
            "description": "Number of threads",
            "nullable": true,
            "readOnly": true
          },
          "type": {
            "type": "string",
            "description": "Type of CPU",
            "nullable": true,
            "readOnly": true
          }
        }
      },
      "commercialCatalog.BlobContentTechnicalConnection": {
        "type": "object",
        "description": "Describes connection information",
        "properties": {
          "clients": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnicalConnectionClients"
              }
            ],
            "description": "Connection information per client",
            "readOnly": true
          },
          "total": {
            "type": "integer",
            "description": "Total of allowed connections",
            "readOnly": true
          }
        }
      },
      "commercialCatalog.BlobContentTechnicalConnectionClients": {
        "type": "object",
        "description": "Describes connection information for concurrent clients",
        "properties": {
          "concurrency": {
            "type": "integer",
            "description": "Number of allowed concurrent clients",
            "readOnly": true
          },
          "number": {
            "type": "integer",
            "description": "Number of allowed concurrent connections per client",
            "readOnly": true
          }
        }
      },
      "commercialCatalog.BlobContentTechnicalDisk": {
        "type": "object",
        "description": "One kind of disk included with an offer",
        "properties": {
          "capacity": {
            "type": "number",
            "description": "Capacity of a single disk of this kind, counted in sizeUnit. Read it as gigabytes when sizeUnit is not set.",
            "readOnly": true
          },
          "interface": {
            "type": "string",
            "description": "How the disk is attached, for example SATA or NVMe. Null when the offer does not state it.",
            "nullable": true,
            "readOnly": true
          },
          "iops": {
            "type": "integer",
            "description": "Disk operations per second this kind of disk is rated for. Null when the offer does not state it.",
            "nullable": true,
            "readOnly": true
          },
          "maximumCapacity": {
            "type": "number",
            "description": "Largest capacity this kind of disk can be extended to, counted in sizeUnit. Null when it cannot be extended.",
            "nullable": true,
            "readOnly": true
          },
          "number": {
            "type": "integer",
            "description": "How many disks of this kind are included. Null when the offer does not state it.",
            "nullable": true,
            "readOnly": true
          },
          "sizeUnit": {
            "type": "string",
            "description": "Unit that capacity and maximumCapacity are expressed in. Null means gigabytes.",
            "nullable": true,
            "readOnly": true
          },
          "technology": {
            "type": "string",
            "description": "Storage technology of the disk, for example SSD or HDD. Null when the offer does not state it.",
            "nullable": true,
            "readOnly": true
          }
        }
      },
      "commercialCatalog.BlobContentTechnicalEphemeralStorage": {
        "type": "object",
        "description": "Describes ephemeral storage information",
        "properties": {
          "disks": {
            "type": "array",
            "description": "Disk properties",
            "items": {
              "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnicalDisk"
            },
            "readOnly": true
          }
        }
      },
      "commercialCatalog.BlobContentTechnicalGPU": {
        "type": "object",
        "description": "Describes GPU information",
        "properties": {
          "memory": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnicalMemory"
              }
            ],
            "description": "GPU memory size",
            "readOnly": true
          },
          "model": {
            "type": "string",
            "description": "GPU model",
            "readOnly": true
          },
          "number": {
            "type": "integer",
            "description": "GPU number",
            "readOnly": true
          },
          "performance": {
            "type": "number",
            "description": "GPU performance",
            "nullable": true,
            "readOnly": true
          }
        }
      },
      "commercialCatalog.BlobContentTechnicalMemory": {
        "type": "object",
        "description": "Amount and type of RAM included with an offer",
        "properties": {
          "interface": {
            "type": "string",
            "description": "Memory technology used, for example DDR4 or DDR5. Null when the offer does not state it.",
            "nullable": true,
            "readOnly": true
          },
          "size": {
            "type": "number",
            "description": "How much RAM is included, counted in sizeUnit. Read it as gigabytes when sizeUnit is not set.",
            "readOnly": true
          },
          "sizeUnit": {
            "type": "string",
            "description": "Unit that size is expressed in. Null means gigabytes.",
            "nullable": true,
            "readOnly": true
          }
        }
      },
      "commercialCatalog.BlobContentTechnicalNetwork": {
        "type": "object",
        "description": "Network bandwidth included with an offer, whether public or private",
        "properties": {
          "guaranteed": {
            "type": "boolean",
            "description": "Whether the stated bandwidth is held under load, rather than reached only when capacity is free",
            "nullable": true,
            "readOnly": true
          },
          "isMax": {
            "type": "boolean",
            "description": "Whether level should be read as a ceiling the product may reach, rather than a rate it always gets",
            "nullable": true,
            "readOnly": true
          },
          "level": {
            "type": "number",
            "description": "Bandwidth included with the offer, counted in unit",
            "nullable": true,
            "readOnly": true
          },
          "max": {
            "type": "number",
            "description": "Highest bandwidth the product can reach in a burst, counted in maxUnit. Null when it cannot exceed level.",
            "nullable": true,
            "readOnly": true
          },
          "maxUnit": {
            "type": "string",
            "description": "Unit that max is expressed in",
            "nullable": true,
            "readOnly": true
          },
          "unit": {
            "type": "string",
            "description": "Unit that level is expressed in",
            "nullable": true,
            "readOnly": true
          },
          "unlimited": {
            "type": "boolean",
            "description": "Whether traffic is uncapped, so no volume limit applies however much is transferred",
            "nullable": true,
            "readOnly": true
          }
        }
      },
      "commercialCatalog.BlobContentTechnicalNodes": {
        "type": "object",
        "description": "Describes node information",
        "properties": {
          "number": {
            "type": "integer",
            "description": "Number of nodes",
            "readOnly": true
          }
        }
      },
      "commercialCatalog.BlobContentTechnicalNvme": {
        "type": "object",
        "description": "Describes NVME storage information",
        "properties": {
          "disks": {
            "type": "array",
            "description": "Disk properties",
            "items": {
              "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnicalDisk"
            },
            "readOnly": true
          }
        }
      },
      "commercialCatalog.BlobContentTechnicalOS": {
        "type": "object",
        "description": "Operating system an offer ships with",
        "properties": {
          "family": {
            "type": "string",
            "description": "Operating system family installed on the product, for example Linux or Windows",
            "readOnly": true
          }
        }
      },
      "commercialCatalog.BlobContentTechnicalPerSeconds": {
        "type": "object",
        "description": "A per-second capacity figure of an offer, such as connections or requests it can serve",
        "properties": {
          "total": {
            "type": "integer",
            "description": "How many are handled per second, counted in unit",
            "readOnly": true
          },
          "unit": {
            "type": "string",
            "description": "Unit that total is expressed in",
            "nullable": true,
            "readOnly": true
          }
        }
      },
      "commercialCatalog.BlobContentTechnicalStorage": {
        "type": "object",
        "description": "Disks included with an offer, and how they are arranged",
        "properties": {
          "disks": {
            "type": "array",
            "description": "Each kind of disk included with the offer, with its capacity and technology",
            "items": {
              "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnicalDisk"
            },
            "readOnly": true
          },
          "raid": {
            "type": "string",
            "description": "RAID arrangement the disks are delivered in, which determines usable capacity and redundancy. Null when the disks are not arranged in RAID.",
            "nullable": true,
            "readOnly": true
          }
        }
      },
      "commercialCatalog.BlobContentTechnicalThroughput": {
        "type": "object",
        "description": "Data throughput an offer is rated for",
        "properties": {
          "level": {
            "type": "integer",
            "description": "Throughput tier of the offer. A higher tier means more data can move through the product per second.",
            "readOnly": true
          }
        }
      },
      "commercialCatalog.BlobContentTechnicalVolume": {
        "type": "object",
        "description": "Describes volume information",
        "properties": {
          "capacity": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnicalVolumeCapacity"
              }
            ],
            "description": "Disk capacity details",
            "readOnly": true
          },
          "iops": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.BlobContentTechnicalVolumeIops"
              }
            ],
            "description": "Input/Output operations per second details",
            "readOnly": true
          }
        }
      },
      "commercialCatalog.BlobContentTechnicalVolumeCapacity": {
        "type": "object",
        "description": "Describes volume capacity",
        "properties": {
          "max": {
            "type": "integer",
            "description": "Maximum volume capacity in GB",
            "readOnly": true
          }
        }
      },
      "commercialCatalog.BlobContentTechnicalVolumeIops": {
        "type": "object",
        "description": "Disk operation rate a volume offer is rated for",
        "properties": {
          "guaranteed": {
            "type": "boolean",
            "description": "Whether the rated level is held under load, rather than reached only when capacity is free",
            "readOnly": true
          },
          "level": {
            "type": "integer",
            "description": "Rate of disk operations per second the volume is rated for, counted in unit",
            "readOnly": true
          },
          "max": {
            "type": "integer",
            "description": "Highest rate the volume can reach in a burst, counted in maxUnit. Null when it cannot exceed its rated level.",
            "nullable": true,
            "readOnly": true
          },
          "maxUnit": {
            "type": "string",
            "description": "Unit that max is expressed in",
            "nullable": true,
            "readOnly": true
          },
          "unit": {
            "type": "string",
            "description": "Unit that level is expressed in",
            "nullable": true,
            "readOnly": true
          }
        }
      },
      "commercialCatalog.Catalog": {
        "type": "object",
        "description": "Identifies the catalog that generated an offer",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identifier of the catalog",
            "readOnly": true
          },
          "name": {
            "type": "string",
            "description": "Catalog name",
            "readOnly": true
          }
        }
      },
      "commercialCatalog.CommercialProduct": {
        "type": "object",
        "description": "Product sold by the offer it is attached to",
        "properties": {
          "code": {
            "type": "string",
            "description": "Product code",
            "readOnly": true
          },
          "descriptions": {
            "type": "array",
            "description": "Description of the commercial product",
            "items": {
              "$ref": "#/components/schemas/commercialCatalog.Description"
            },
            "readOnly": true
          }
        }
      },
      "commercialCatalog.CommercialRatingValue": {
        "type": "object",
        "description": "Defines the applicable rating values",
        "properties": {
          "invoiceLabels": {
            "type": "array",
            "description": "Label of the invoice",
            "items": {
              "$ref": "#/components/schemas/commercialCatalog.InvoiceLabel"
            },
            "readOnly": true
          },
          "ratingValue": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.RatingValue"
              }
            ],
            "description": "Rating value to link the offer to",
            "readOnly": true
          }
        }
      },
      "commercialCatalog.CompositeOfferCommercialOffer": {
        "type": "object",
        "description": "Describes offers composition",
        "properties": {
          "commercialOffer": {
            "type": "string",
            "description": "Offer embedded in the composite offer, represented by its id",
            "readOnly": true
          },
          "max": {
            "type": "integer",
            "description": "Maximum number of commercial offers which may compose the composite offer. min = max means the quantity is forced.",
            "nullable": true,
            "readOnly": true
          },
          "min": {
            "type": "integer",
            "description": "Minimum number of commercial offers which may compose the composite offer",
            "readOnly": true
          },
          "resourceDeliveryQuantity": {
            "type": "integer",
            "description": "Number of services the commercial offer is delivered as within the composite offer. Defaults to 1.",
            "readOnly": true
          }
        }
      },
      "commercialCatalog.CurrencyCodeEnum": {
        "type": "string",
        "description": "Currency code following ISO4217 format",
        "enum": [
          "AUD",
          "CAD",
          "CZK",
          "EUR",
          "GBP",
          "INR",
          "LTL",
          "MAD",
          "PLN",
          "SGD",
          "TND",
          "USD",
          "XOF"
        ]
      },
      "commercialCatalog.Description": {
        "type": "object",
        "description": "Commercial wording of an offer in one language. The catalog returns one entry per language it is translated into.",
        "properties": {
          "language": {
            "allOf": [
              {
                "$ref": "#/components/schemas/common.LanguageEnum"
              }
            ],
            "description": "Language this wording is written in",
            "readOnly": true
          },
          "longLabel": {
            "type": "string",
            "description": "Full commercial description of the offer, for a product page or a detailed view",
            "readOnly": true
          },
          "shortLabel": {
            "type": "string",
            "description": "Brief commercial name of the offer, for a list or a summary line",
            "readOnly": true
          }
        }
      },
      "commercialCatalog.Engagement": {
        "type": "object",
        "description": "Describes engagement information",
        "properties": {
          "autoReactivation": {
            "type": "boolean",
            "description": "Whether the engagement reactivates itself",
            "readOnly": true
          },
          "validDuration": {
            "type": "string",
            "description": "Engagement duration following ISO8601 format",
            "format": "duration",
            "readOnly": true
          }
        }
      },
      "commercialCatalog.InvoiceLabel": {
        "type": "object",
        "description": "Translated invoice label",
        "properties": {
          "label": {
            "type": "string",
            "description": "Invoice label",
            "readOnly": true
          },
          "language": {
            "allOf": [
              {
                "$ref": "#/components/schemas/common.LanguageEnum"
              }
            ],
            "description": "Label language",
            "readOnly": true
          }
        }
      },
      "commercialCatalog.Legacy": {
        "type": "object",
        "description": "Describes legacy information, used for transition between offer models",
        "properties": {
          "blobs": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.Blob"
              }
            ],
            "description": "Contains content from previous model",
            "nullable": true,
            "readOnly": true
          },
          "catalog": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.Catalog"
              }
            ],
            "description": "Catalog used to generate the offer",
            "nullable": true,
            "readOnly": true
          },
          "plan": {
            "type": "string",
            "description": "Previous model identifier",
            "readOnly": true
          }
        }
      },
      "commercialCatalog.MerchantEnum": {
        "type": "string",
        "description": "Merchants where offers are available",
        "enum": [
          "ASIA",
          "AU",
          "CA",
          "DE",
          "ES",
          "FR",
          "GB",
          "IE",
          "IN",
          "IT",
          "MA",
          "NL",
          "PL",
          "PT",
          "QC",
          "SG",
          "SN",
          "TN",
          "US",
          "WE",
          "WS"
        ]
      },
      "commercialCatalog.Offer": {
        "type": "object",
        "description": "Defines a commercial catalog offer",
        "properties": {
          "code": {
            "type": "string",
            "description": "Unique code for the offer",
            "readOnly": true
          },
          "commercialRatingValues": {
            "type": "array",
            "description": "Applicable commercial rating values",
            "items": {
              "$ref": "#/components/schemas/commercialCatalog.CommercialRatingValue"
            },
            "readOnly": true
          },
          "descriptions": {
            "type": "array",
            "description": "Offer description",
            "items": {
              "$ref": "#/components/schemas/commercialCatalog.Description"
            },
            "readOnly": true
          },
          "engagements": {
            "type": "array",
            "description": "List of engagements available to subscribe the offer to",
            "items": {
              "$ref": "#/components/schemas/commercialCatalog.Engagement"
            },
            "readOnly": true
          },
          "id": {
            "type": "string",
            "description": "Unique identifier of the offer",
            "readOnly": true
          },
          "legacy": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.Legacy"
              }
            ],
            "description": "Offer information based on previous model used for migration to the new model",
            "nullable": true,
            "readOnly": true
          },
          "nature": {
            "allOf": [
              {
                "$ref": "#/components/schemas/commercialCatalog.OfferNatureEnum"
              }
            ],
            "description": "Offer nature",
            "readOnly": true
          },
          "offers": {
            "type": "array",
            "description": "Sub offers when type is composite",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/commercialCatalog.CompositeOfferCommercialOffer"
            },
