{
  "openapi": "3.0.0",
  "info": {
    "title": "OVHcloud API specification",
    "description": "Specification for OVHcloud API",
    "version": "1.0",
    "contact": {
      "name": "OVH",
      "email": "api@ml.ovh.net"
    }
  },
  "servers": [
    {
      "url": "https://api.eu.ovhcloud.com/v2"
    }
  ],
  "components": {
    "schemas": {
      "any": {
        "description": "Can be anything (text, int, bool, json, html, etc.)",
        "example": "This is a content of any type !"
      },
      "duration": {
        "type": "string",
        "description": "Duration (e.g., P1Y2M3DT4H6M9S)",
        "example": "P1Y2M3DT4H6M9S"
      },
      "email": {
        "type": "string",
        "description": "Email address (e.g., api@ml.ovh.net)",
        "format": "email",
        "example": "api@ml.ovh.net"
      },
      "internationalPhoneNumber": {
        "type": "string",
        "description": "International phone number",
        "format": "phone-number"
      },
      "ip": {
        "type": "string",
        "description": "IP address (e.g., 192.0.2.0)",
        "format": "ipv4",
        "example": "192.0.2.0"
      },
      "ipBlock": {
        "type": "string",
        "description": "IP (v4 or v6) CIDR notation (e.g., 192.0.2.0/24)",
        "format": "ip-block",
        "example": "192.0.2.0/24"
      },
      "ipInterface": {
        "type": "string",
        "description": "IP address (e.g., 192.0.2.0)",
        "format": "ipv4",
        "example": "192.0.2.0"
      },
      "ipv4": {
        "type": "string",
        "description": "IPv4 address (e.g., 192.0.2.0)",
        "format": "ipv4",
        "example": "192.0.2.0"
      },
      "ipv4Block": {
        "type": "string",
        "description": "IPv4 CIDR notation (e.g., 192.0.2.0/24)",
        "format": "ipv4-block",
        "example": "192.0.2.0/24"
      },
      "ipv6": {
        "type": "string",
        "description": "IPv6 address (e.g., 2001:41d0:1:1994::1)",
        "format": "ipv6",
        "example": "2001:41d0:1:1994::1"
      },
      "ipv6Block": {
        "type": "string",
        "description": "IPv6 CIDR notation (e.g., 2001:41d0::/128)",
        "format": "ipv6-block",
        "example": "2001:41d0::/128"
      },
      "macAddress": {
        "type": "string",
        "description": "MAC address (e.g., 00:00:5e:00:53:01)",
        "format": "mac-address",
        "example": "00:00:5e:00:53:01"
      },
      "phoneNumber": {
        "type": "string",
        "description": "Phone number",
        "format": "phone-number"
      },
      "revisions.revision.AccountRevision": {
        "type": "object",
        "description": "API revision resource",
        "properties": {
          "availableRevisions": {
            "type": "array",
            "description": "Available API revisions to transition to",
            "items": {
              "type": "string"
            },
            "readOnly": true
          },
          "currentState": {
            "allOf": [
              {
                "$ref": "#/components/schemas/revisions.revision.AccountRevisionCurrentState"
              }
            ],
            "description": "Current state of the API revision",
            "readOnly": true
          },
          "targetSpec": {
            "allOf": [
              {
                "$ref": "#/components/schemas/revisions.revision.AccountRevisionTargetSpec"
              }
            ],
            "description": "Target specification for the API revision",
            "readOnly": true
          }
        }
      },
      "revisions.revision.AccountRevisionCurrentState": {
        "type": "object",
        "description": "Current state of the API revision",
        "properties": {
          "revision": {
            "type": "string",
            "description": "Currently active API revision",
            "readOnly": true
          }
        }
      },
      "revisions.revision.AccountRevisionInput": {
        "type": "object",
        "description": "Input payload to update the API revision",
        "properties": {
          "targetSpec": {
            "allOf": [
              {
                "$ref": "#/components/schemas/revisions.revision.AccountRevisionTargetSpec"
              }
            ],
            "description": "Requested target specification"
          }
        },
        "required": [
          "targetSpec"
        ]
      },
      "revisions.revision.AccountRevisionTargetSpec": {
        "type": "object",
        "description": "Target specification for the API revision",
        "properties": {
          "revision": {
            "type": "string",
            "description": "API revision to set as active"
          }
        },
        "required": [
          "revision"
        ]
      },
      "time": {
        "type": "string",
        "description": "Time (e.g., 15:04:05)",
        "format": "time",
        "example": "15:04:05"
      }
    },
    "securitySchemes": {
      "oAuth2AuthCode": {
        "type": "oauth2",
        "description": "Oauth2",
        "x-client-id": "1bb9c7df371741c0",
        "x-client-secret": "a5b4de870aca620d10fbf63cd18d205b",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://auth.eu.ovhcloud.com/oauth2/authorize",
            "tokenUrl": "https://auth.eu.ovhcloud.com/oauth2/token",
            "scopes": {
              "account/all": "Manage your account",
              "all": "Manage your whole account and all your services",
              "services/all": "Manage your services lifecycle and billing"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/account/api/revision": {
      "get": {
        "operationId": "getApiRevision",
        "summary": "Get the current and available API revisions",
        "security": [
          {
            "oAuth2AuthCode": []
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/revisions.revision.AccountRevision"
                },
                "examples": {
                  "Get the current API revision": {
                    "value": {
                      "availableRevisions": [
                        "2026-06",
                        "2026-09"
                      ],
                      "currentState": {
                        "revision": "2026-06"
                      },
                      "targetSpec": {
                        "revision": "2026-06"
                      }
                    },
                    "summary": "Response body containing the current and available API revisions"
                  }
                }
              }
            }
          }
        },
        "x-developer-hub-navigation": [
          [
            "Account",
            "Profile"
          ]
        ],
        "x-badges": [
          {
            "color": "blue",
            "label": "Alpha version"
          }
        ],
        "x-iam-actions": [
          {
            "name": "account:apiovh:revision/get",
            "required": true
          }
        ]
      },
      "put": {
        "operationId": "editApiRevision",
        "summary": "Update the current API revision",
        "security": [
          {
            "oAuth2AuthCode": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/revisions.revision.AccountRevisionInput"
              },
              "examples": {
                "Switch to API revision 2026-09": {
                  "value": {
                    "targetSpec": {
                      "revision": "2026-09"
                    }
                  },
                  "summary": "Request body to switch to API revision 2026-09"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/revisions.revision.AccountRevision"
                },
                "examples": {
                  "Switch to API revision 2026-09": {
                    "value": {
                      "availableRevisions": [
                        "2026-06",
                        "2026-09"
                      ],
                      "currentState": {
                        "revision": "2026-06"
                      },
                      "targetSpec": {
                        "revision": "2026-09"
                      }
                    },
                    "summary": "Response body after switching to API revision 2026-09"
                  }
                }
              }
            }
          }
        },
        "x-developer-hub-navigation": [
          [
            "Account",
            "Profile"
          ]
        ],
        "x-badges": [
          {
            "color": "blue",
            "label": "Alpha version"
          }
        ],
        "x-iam-actions": [
          {
            "name": "account:apiovh:revision/edit",
            "required": true
          }
        ]
      }
    }
  }
}
