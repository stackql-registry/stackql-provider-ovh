      "supply.MondialRelay": {
        "type": "object",
        "description": "Mondial Relay Point Details",
        "properties": {
          "address": {
            "type": "string",
            "description": "Relay point address"
          },
          "city": {
            "type": "string",
            "description": "City"
          },
          "closing": {
            "type": "array",
            "description": "Relay point closing dates",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/supply.MondialRelayClosingPeriod"
            }
          },
          "country": {
            "allOf": [
              {
                "$ref": "#/components/schemas/coreTypes.CountryEnum"
              }
            ],
            "description": "Relay country"
          },
          "distance": {
            "type": "number",
            "description": "Distance between address and relay point",
            "nullable": true
          },
          "id": {
            "type": "string",
            "description": "Mondial Relay point ID"
          },
          "lat": {
            "type": "number",
            "description": "Relay point latitude"
          },
          "lng": {
            "type": "number",
            "description": "Relay point longitude"
          },
          "mapUrl": {
            "type": "string",
            "description": "URL of short map",
            "nullable": true
          },
          "name": {
            "type": "string",
            "description": "Relay point name"
          },
          "opening": {
            "allOf": [
              {
                "$ref": "#/components/schemas/supply.MondialRelayOpening"
              }
            ],
            "description": "Relay point opening hours"
          },
          "pictureUrl": {
            "type": "string",
            "description": "Relay point picture\\s URL",
            "nullable": true
          },
          "zipcode": {
            "type": "string",
            "description": "Zipcode"
          }
        }
      },
      "supply.MondialRelayClosingPeriod": {
        "type": "object",
        "description": "Closing period for mondial relay point",
        "properties": {
          "end": {
            "type": "string",
            "description": "Ending of closing period",
            "format": "date-time"
          },
          "start": {
            "type": "string",
            "description": "Beginning of closing period",
            "format": "date-time"
          }
        }
      },
      "supply.MondialRelayDayPeriod": {
        "type": "object",
        "description": "Opening range for mondial relay point",
        "properties": {
          "end": {
            "type": "string",
            "description": "Ending time (00:00 format)"
          },
          "start": {
            "type": "string",
            "description": "Starting time (00:00 format)"
          }
        }
      },
      "supply.MondialRelayOpening": {
        "type": "object",
        "description": "Day with schedule for mondial relay point opening",
        "properties": {
          "friday": {
            "type": "array",
            "description": "Opening range",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/supply.MondialRelayDayPeriod"
            }
          },
          "monday": {
            "type": "array",
            "description": "Opening range",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/supply.MondialRelayDayPeriod"
            }
          },
          "saturday": {
            "type": "array",
            "description": "Opening range",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/supply.MondialRelayDayPeriod"
            }
          },
          "sunday": {
            "type": "array",
            "description": "Opening range",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/supply.MondialRelayDayPeriod"
            }
          },
          "thursday": {
            "type": "array",
            "description": "Opening range",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/supply.MondialRelayDayPeriod"
            }
          },
          "tuesday": {
            "type": "array",
            "description": "Opening range",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/supply.MondialRelayDayPeriod"
            }
          },
          "wednesday": {
            "type": "array",
            "description": "Opening range",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/supply.MondialRelayDayPeriod"
            }
          }
        }
      },
      "supply.MondialRelayResult": {
        "type": "object",
        "description": "Status and Mondial Relay Point Details",
        "properties": {
          "referenceAddress": {
            "type": "string",
            "description": "Reference address for finding RelayPoints"
          },
          "relayPoints": {
            "type": "array",
            "description": "Array of relay points",
            "items": {
              "$ref": "#/components/schemas/supply.MondialRelay"
            }
          }
        }
      },
      "supply.MondialRelayReturn": {
        "type": "object",
        "description": "Status and Mondial Relay Point Details",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error",
            "nullable": true
          },
          "result": {
            "allOf": [
              {
                "$ref": "#/components/schemas/supply.MondialRelayResult"
              }
            ],
            "description": "Relay points list and reference address",
            "nullable": true
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/supply.Status"
              }
            ],
            "description": "Request status"
          }
        }
      },
      "supply.Status": {
        "type": "string",
        "description": "Request status",
        "enum": [
          "error",
          "ok",
          "pending"
        ]
      },
      "time": {
        "type": "string",
        "description": "Time (e.g., 15:04:05)",
        "format": "time",
        "example": "15:04:05"
      }
    },
    "securitySchemes": {
      "oAuth2AuthCode": {
        "type": "oauth2",
        "description": "Oauth2",
        "x-client-id": "1bb9c7df371741c0",
        "x-client-secret": "a5b4de870aca620d10fbf63cd18d205b",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://auth.eu.ovhcloud.com/oauth2/authorize",
            "tokenUrl": "https://auth.eu.ovhcloud.com/oauth2/token",
            "scopes": {
              "account/all": "Manage your account",
              "all": "Manage your whole account and all your services",
              "services/all": "Manage your services lifecycle and billing"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/supply/mondialRelay": {
      "post": {
        "summary": "Find the 10 nearest MondialRelay points from address or city.",
        "security": [
          {
            "oAuth2AuthCode": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "address": {
                    "type": "string",
                    "description": "Address"
                  },
                  "city": {
                    "type": "string",
                    "description": "City"
                  },
                  "country": {
                    "description": "ISO country code",
                    "$ref": "#/components/schemas/coreTypes.CountryEnum"
                  },
                  "zipcode": {
                    "type": "string",
                    "description": "Zip Code"
                  }
                },
                "required": [
                  "country"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/supply.MondialRelayReturn"
                }
              }
            }
          }
        },
        "x-badges": [
          {
            "color": "green",
            "label": "Stable production version"
          }
        ],
        "x-iam-actions": [
          {
            "name": "account:apiovh:supplyMondialRelay/create",
            "required": true
          }
        ]
      }
    }
  }
