          "account": {
            "allOf": [
              {
                "$ref": "#/components/schemas/partner2.Account"
              }
            ],
            "description": "Account"
          },
          "areaOfExpertise": {
            "type": "array",
            "description": "DEPRECATED - Area of Expertise",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/partner2.AreaOfExpertiseEnum"
            }
          },
          "contact": {
            "allOf": [
              {
                "$ref": "#/components/schemas/partner2.Contact"
              }
            ],
            "description": "Contact",
            "nullable": true
          },
          "partnersProgramReason": {
            "type": "string",
            "description": "DEPRECATED - Why you want to take part in OVH's Partners Program",
            "nullable": true
          },
          "partnership": {
            "allOf": [
              {
                "$ref": "#/components/schemas/partner2.PartnerShip"
              }
            ],
            "description": " How the PartnerShip will Growth"
          },
          "salesProjection": {
            "type": "number",
            "description": "DEPRECATED - Sales Projection (in euros) ",
            "nullable": true
          }
        },
        "required": [
          "account"
        ]
      },
