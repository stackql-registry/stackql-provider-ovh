  "paths": {
    "/partner": {
      "get": {
        "summary": "Get partner status",
        "security": [
          {
            "oAuth2AuthCode": []
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/partner2.Partner"
                }
              }
            }
          },
          "404": {
            "description": "Error 404 response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Common error model",
                  "properties": {
                    "class": {
                      "type": "string",
                      "description": "Class of the error"
                    },
                    "message": {
                      "type": "string",
                      "description": "Error message"
                    }
                  }
                },
                "examples": {
                  "Client::NotFound::PartnerNotFound": {
                    "value": {
                      "class": "Client::NotFound::PartnerNotFound",
                      "message": "Partner not found"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error 500 response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Common error model",
                  "properties": {
                    "class": {
                      "type": "string",
                      "description": "Class of the error"
