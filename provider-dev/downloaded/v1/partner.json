          "RegisteredQualified",
          "Rejected"
        ]
      },
      "partner2.Account": {
        "type": "object",
        "description": "Account Entity",
        "properties": {
          "city": {
            "type": "string",
            "description": "DEPRECATED - Account City",
            "nullable": true
          },
          "companyTurnover": {
            "type": "number",
            "description": "Company turnover (in euros)",
            "nullable": true
          },
          "country": {
            "allOf": [
              {
                "$ref": "#/components/schemas/nichandle.CountryEnum"
              }
            ],
            "description": "DEPRECATED - Account Country",
            "nullable": true
          },
          "name": {
            "type": "string",
            "description": "Account Name"
          },
          "numberOfEmployees": {
            "allOf": [
              {
                "$ref": "#/components/schemas/partner2.employeesNumberEnum"
              }
            ],
            "description": "Number of employees",
            "nullable": true
          },
          "partnerType": {
            "allOf": [
              {
                "$ref": "#/components/schemas/partner2.partnerTypeEnum"
              }
            ],
            "description": "Partner Type",
            "nullable": true
          },
          "yearEstablished": {
            "type": "string",
            "description": "In what year was your company established?",
            "nullable": true,
            "format": "date"
          }
        },
        "required": [
          "name"
        ]
