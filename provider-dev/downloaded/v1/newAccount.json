  "paths": {
    "/newAccount": {
      "post": {
        "summary": "Create a new OVH identifier",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "address": {
                    "type": "string"
                  },
                  "area": {
                    "type": "string"
                  },
                  "birthCity": {
                    "type": "string"
                  },
                  "birthDay": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string"
                  },
                  "companyNationalIdentificationNumber": {
                    "type": "string"
                  },
                  "corporationType": {
                    "type": "string"
                  },
                  "country": {
                    "$ref": "#/components/schemas/nichandle.CountryEnum"
                  },
                  "einvoicingBillingAddress": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "fax": {
                    "type": "string"
                  },
                  "firstname": {
                    "type": "string"
                  },
                  "italianSDI": {
                    "type": "string"
                  },
                  "language": {
                    "$ref": "#/components/schemas/nichandle.LanguageEnum"
                  },
                  "legalform": {
                    "$ref": "#/components/schemas/nichandle.LegalFormEnum"
                  },
                  "name": {
                    "type": "string"
                  },
                  "nationalIdentificationNumber": {
                    "type": "string"
                  },
                  "organisation": {
                    "type": "string"
                  },
                  "ovhCompany": {
                    "$ref": "#/components/schemas/nichandle.OvhCompanyEnum"
                  },
                  "ovhSubsidiary": {
                    "$ref": "#/components/schemas/nichandle.OvhSubsidiaryEnum"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "phoneCountry": {
                    "$ref": "#/components/schemas/nichandle.CountryEnum"
                  },
                  "phoneType": {
                    "$ref": "#/components/schemas/nichandle.PhoneTypeEnum"
                  },
                  "purposeOfPurchase": {
                    "type": "string"
                  },
                  "sex": {
                    "$ref": "#/components/schemas/nichandle.GenderEnum"
                  },
                  "spareEmail": {
                    "type": "string"
                  },
                  "vat": {
                    "type": "string"
                  },
                  "zip": {
                    "type": "string"
                  }
                },
                "required": [
                  "country",
                  "email",
                  "legalform",
                  "ovhCompany",
                  "ovhSubsidiary"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/nichandle.NewAccountAndToken"
                }
              }
            }
          }
        },
        "x-badges": [
          {
            "color": "green",
            "label": "Stable production version"
          }
        ]
      }
    },
