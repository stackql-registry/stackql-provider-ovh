      "startup.startup": {
        "type": "object",
        "description": "Startup Entity",
        "properties": {
          "acceptanceStatus": {
            "allOf": [
              {
                "$ref": "#/components/schemas/startup.acceptanceStatusEnum"
              }
            ],
            "description": "Acceptance Status",
            "nullable": true,
            "readOnly": true
          },
          "awarness": {
            "allOf": [
              {
                "$ref": "#/components/schemas/startup.awarnessEnum"
