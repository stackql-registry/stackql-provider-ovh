                "$ref": "#/components/schemas/startup.startup.company"
              }
            ],
            "description": "Company information"
          },
          "eventCode": {
            "type": "string",
            "description": "Code given to startups during events or partnerships.",
            "nullable": true
          },
          "fundRaising": {
            "allOf": [
              {
                "$ref": "#/components/schemas/startup.startup.fundRaising"
              }
            ],
            "description": "Fund raising info"
          },
          "project": {
            "allOf": [
