# Live smoke-test credentials for the StackQL ovh provider (copy to .env -
# gitignored - and fill in). `make smoke*` sources .env when present. Never
# point this at a production account.
#
# The variable names are the ones the OVHcloud Terraform provider and the
# go-ovh client read. Never a real value in this file.

# The API region: ovh-eu (the default when unset), ovh-ca or ovh-us. It
# selects both the API host and the OAuth2 token host. A region identifier,
# not a Control Panel URL.
OVH_ENDPOINT=ovh-eu

# METHOD 1 (the provider's default): OAUTH2 SERVICE ACCOUNT
# 1. Create a service account: POST /me/api/oauth2/client with
#    flow CLIENT_CREDENTIALS, or in the Control Panel under
#    Identity, Security & Operations > Identities > Service accounts.
#    Keep the clientId and clientSecret it returns.
# 2. Grant it rights with an IAM policy that names its identity URN
#    (GET /me/api/oauth2/client/{clientId} returns it). A service account
#    has no rights until a policy grants them: an authenticated call with no
#    matching policy answers 403 and names the IAM action it lacked.
OVH_CLIENT_ID=replace_with_service_account_client_id
OVH_CLIENT_SECRET=replace_with_service_account_client_secret

# METHOD 2 (alternative): PRE-ISSUED BEARER TOKEN
# A short-lived OAuth2 access token you already hold. The provider's default
# is the client credentials grant, so this needs the --auth override:
#   stackql shell --auth='{"ovh": {"type": "bearer", "credentialsenvvar": "OVH_ACCESS_TOKEN"}}'
# The smoke suite uses it automatically when the two METHOD 1 variables are
# unset. The token is not refreshed.
#OVH_ACCESS_TOKEN=replace_with_short_lived_bearer_access_token

# NOT SUPPORTED YET: APPLICATION KEY SIGNING (AK / AS / CK)
# The provider cannot use these: StackQL has no request signing method for
# OVHcloud application keys yet (https://github.com/stackql-labs/omnisdk/issues/56).
# They are listed because go-ovh and the Terraform provider read them, and
# because a signed call is how the service account above gets its first IAM
# policy when the account has no other administrator credential.
#OVH_APPLICATION_KEY=replace_with_application_key
#OVH_APPLICATION_SECRET=replace_with_application_secret
#OVH_CONSUMER_KEY=replace_with_consumer_key

# The Public Cloud project the smoke suite runs in (the project ID, not its
# name). Resolves the project server variable (x-stackQL-envVar) of the
# Public Cloud services, so scoped queries need no WHERE service_name clause.
OVH_CLOUD_PROJECT_SERVICE=replace_with_public_cloud_project_id

# Optional, gated instance lifecycle only (make smoke-instance-lifecycle).
# The region defaults to the first listed region that offers flavors; the
# image is matched by its exact name.
#OVH_SMOKE_REGION=GRA11
#OVH_SMOKE_FLAVOR=d2-2
#OVH_SMOKE_IMAGE='Debian 12'
